From 2c38aef97878de384f14437ae10a224db33362ce Mon Sep 17 00:00:00 2001
From: Paolo Cignoni <paolo.cignoni@cnr.it>
Date: Sat, 22 Aug 2026 13:16:25 +0200
Subject: [PATCH] Fix scale in fit_similarity_alignment: normalise the variance
 term

fit_similarity_alignment returned a scale factor exactly n times too
small, where n is the number of corresponding points.

cross_covariance_of() divides H by n, so trace(R^T H) carries a 1/n
factor. The scale was then computed as trace(R^T H) / sum_sq_X, where
sum_sq_X was the raw sum of squared distances from the centroid, with no
matching division. Umeyama (1991, eq. 41) uses the variance for that
denominator, so the two terms must share the same normalisation.

Divide the term by n, and rename it var_X to record that it is a
variance rather than a sum.

Rotation was unaffected: it depends only on the singular vectors of H,
which are invariant to a positive rescaling of H. That is why
fit_rigid_alignment, which never uses the magnitude, is correct, and why
this only surfaced through the scale.

Minimal reproduction before the fix, on a pure scale-2 similarity with
well-spread 3D points:

    n=  8   recovered scale 0.2500   expected 2.0
    n= 50   recovered scale 0.0400   expected 2.0
    n=642   recovered scale 0.0031   expected 2.0

Add four regression tests, mirroring the existing style in
tests/geometry/test_alignment.cpp, which had 26 cases covering
fit_rigid_alignment, fit_obb_alignment, fit_knn_alignment,
fit_icp_alignment and chamfer_error, but none for
fit_similarity_alignment:

  - identity: unit scale is recovered as 1, not 1/n
  - uniform scale + translation
  - scale independent of the point count (the factor-of-n regression)
  - scale + rotation, checked through the recovered row norms

The scale is asserted on the matrix itself, not only through an RMS
error: a collapsed cloud can still produce a plausible-looking RMS
because the translation term absorbs the centroid.

All four fail on the unfixed implementation and pass with the fix.
---
 .../geometry/fit_similarity_alignment.hpp     |  23 ++-
 tests/geometry/test_alignment.cpp             | 137 ++++++++++++++++++
 2 files changed, 153 insertions(+), 7 deletions(-)

diff --git a/include/trueform/geometry/fit_similarity_alignment.hpp b/include/trueform/geometry/fit_similarity_alignment.hpp
index b9df80c..a939cbd 100644
--- a/include/trueform/geometry/fit_similarity_alignment.hpp
+++ b/include/trueform/geometry/fit_similarity_alignment.hpp
@@ -68,16 +68,25 @@ auto fit_similarity_alignment(const tf::points<Policy0> &X_,
   auto cx_world = tf::transformed(cx, tX);
   auto cy_world = tf::transformed(cy, tY);
 
-  // Compute sum of squared distances from centroid for X
-  // trace(X'^T * X') = Σ ||x_i - cx||²
-  // This is rotation-invariant, so we can compute on plain points
-  T sum_sq_X = T(0);
+  // Compute the variance of X about its centroid: (1/n) * Σ ||x_i - cx||².
+  //
+  // This must be normalised by n to match H, which cross_covariance_of() already
+  // divides by n. The scale below is trace(R^T H) / var_X (Umeyama 1991, eq. 41),
+  // and both terms have to carry the same normalisation; using the raw sum here
+  // makes the recovered scale a factor of n too small.
+  //
+  // Rotation-invariant, so it can be computed on the plain points.
+  T var_X = T(0);
   for (const auto &x : X) {
     for (std::size_t d = 0; d < Dims; ++d) {
       T diff = x[d] - cx[d];
-      sum_sq_X += diff * diff;
+      var_X += diff * diff;
     }
   }
+  {
+    const auto n = X.size();
+    var_X /= T(n + (n == 0));
+  }
 
   // HtH = H^T * H
   std::array<std::array<T, Dims>, Dims> HtH{};
@@ -166,8 +175,8 @@ auto fit_similarity_alignment(const tf::points<Policy0> &X_,
     }
   }
 
-  // Compute scale: s = trace(R^T * H) / sum_sq_X
-  T scale = (sum_sq_X > tf::epsilon2<T>) ? trace_RtH / sum_sq_X : T(1);
+  // Compute scale: s = trace(R^T * H) / var_X
+  T scale = (var_X > tf::epsilon2<T>) ? trace_RtH / var_X : T(1);
 
   // Scale the rotation matrix: store s*R
   for (std::size_t i = 0; i < Dims; ++i)
diff --git a/tests/geometry/test_alignment.cpp b/tests/geometry/test_alignment.cpp
index c02538f..85655c8 100644
--- a/tests/geometry/test_alignment.cpp
+++ b/tests/geometry/test_alignment.cpp
@@ -4,6 +4,7 @@
  *
  * Tests for:
  * - fit_rigid_alignment
+ * - fit_similarity_alignment
  * - fit_obb_alignment
  * - fit_knn_alignment
  * - fit_icp_alignment
@@ -164,6 +165,142 @@ TEMPLATE_TEST_CASE("fit_rigid_alignment_rotation_translation", "[geometry][align
     REQUIRE(rms < real_t(1e-4));
 }
 
+// =============================================================================
+// fit_similarity_alignment - Identity (same point clouds, unit scale)
+// =============================================================================
+
+TEMPLATE_TEST_CASE("fit_similarity_alignment_identity", "[geometry][alignment]",
+    (tf::test::type_pair<std::int32_t, float>),
+    (tf::test::type_pair<std::int64_t, double>))
+{
+    using index_t = typename TestType::index_type;
+    using real_t = typename TestType::real_type;
+
+    auto box = tf::make_box_mesh<index_t>(real_t(2), real_t(1), real_t(3));
+
+    auto T = tf::fit_similarity_alignment(box.points(), box.points());
+
+    // Scale must come out as 1, not 1/n. Checked on the matrix directly: an RMS check
+    // alone can look plausible when the cloud collapses towards its centroid.
+    REQUIRE(std::abs(T(0, 0) - real_t(1)) < real_t(1e-4));
+    REQUIRE(std::abs(T(1, 1) - real_t(1)) < real_t(1e-4));
+    REQUIRE(std::abs(T(2, 2) - real_t(1)) < real_t(1e-4));
+
+    real_t rms = compute_rms_error(box.points(), box.points(), T);
+    REQUIRE(rms < real_t(1e-5));
+}
+
+// =============================================================================
+// fit_similarity_alignment - Uniform scale + translation
+// =============================================================================
+
+TEMPLATE_TEST_CASE("fit_similarity_alignment_scale_translation", "[geometry][alignment]",
+    (tf::test::type_pair<std::int32_t, float>),
+    (tf::test::type_pair<std::int64_t, double>))
+{
+    using index_t = typename TestType::index_type;
+    using real_t = typename TestType::real_type;
+
+    auto sphere = tf::make_sphere_mesh<index_t>(real_t(1), 20, 20);
+
+    const real_t scale = real_t(2.5);
+    const real_t shift[3] = {real_t(1), real_t(2), real_t(3)};
+
+    tf::points_buffer<real_t, 3> source;
+    source.allocate(sphere.points().size());
+    for (decltype(sphere.points().size()) i = 0; i < sphere.points().size(); ++i) {
+        for (std::size_t d = 0; d < 3; ++d)
+            source[i][d] = scale * sphere.points()[i][d] + shift[d];
+    }
+
+    // source = scale * target + shift, so aligning source onto target undoes both.
+    auto T = tf::fit_similarity_alignment(source.points(), sphere.points());
+
+    const real_t expected = real_t(1) / scale;
+    REQUIRE(std::abs(T(0, 0) - expected) < real_t(1e-4));
+    REQUIRE(std::abs(T(1, 1) - expected) < real_t(1e-4));
+    REQUIRE(std::abs(T(2, 2) - expected) < real_t(1e-4));
+
+    real_t rms = compute_rms_error(source.points(), sphere.points(), T);
+    REQUIRE(rms < real_t(1e-4));
+}
+
+// =============================================================================
+// fit_similarity_alignment - Scale is independent of the point count
+// =============================================================================
+
+TEMPLATE_TEST_CASE("fit_similarity_alignment_scale_independent_of_size", "[geometry][alignment]",
+    (tf::test::type_pair<std::int32_t, float>),
+    (tf::test::type_pair<std::int64_t, double>))
+{
+    using index_t = typename TestType::index_type;
+    using real_t = typename TestType::real_type;
+
+    // The same similarity recovered from clouds of very different sizes. A scale term
+    // normalised inconsistently with the cross-covariance drifts with n.
+    const real_t scale = real_t(3);
+
+    for (int resolution : {6, 12, 30}) {
+        auto sphere = tf::make_sphere_mesh<index_t>(real_t(1), resolution, resolution);
+
+        tf::points_buffer<real_t, 3> source;
+        source.allocate(sphere.points().size());
+        for (decltype(sphere.points().size()) i = 0; i < sphere.points().size(); ++i) {
+            for (std::size_t d = 0; d < 3; ++d)
+                source[i][d] = scale * sphere.points()[i][d];
+        }
+
+        auto T = tf::fit_similarity_alignment(sphere.points(), source.points());
+
+        REQUIRE(std::abs(T(0, 0) - scale) < real_t(1e-3));
+        REQUIRE(std::abs(T(1, 1) - scale) < real_t(1e-3));
+        REQUIRE(std::abs(T(2, 2) - scale) < real_t(1e-3));
+    }
+}
+
+// =============================================================================
+// fit_similarity_alignment - Scale + rotation
+// =============================================================================
+
+TEMPLATE_TEST_CASE("fit_similarity_alignment_scale_rotation", "[geometry][alignment]",
+    (tf::test::type_pair<std::int32_t, float>),
+    (tf::test::type_pair<std::int64_t, double>))
+{
+    using index_t = typename TestType::index_type;
+    using real_t = typename TestType::real_type;
+
+    auto sphere = tf::make_sphere_mesh<index_t>(real_t(1), 20, 20);
+
+    // 45 degrees about Z, combined with a uniform scale.
+    const real_t angle = real_t(3.14159265358979323846) / real_t(4);
+    const real_t cos_a = std::cos(angle);
+    const real_t sin_a = std::sin(angle);
+    const real_t scale = real_t(1.75);
+
+    tf::points_buffer<real_t, 3> source;
+    source.allocate(sphere.points().size());
+    for (decltype(sphere.points().size()) i = 0; i < sphere.points().size(); ++i) {
+        const auto p = sphere.points()[i];
+        source[i][0] = scale * (cos_a * p[0] - sin_a * p[1]);
+        source[i][1] = scale * (sin_a * p[0] + cos_a * p[1]);
+        source[i][2] = scale * p[2];
+    }
+
+    auto T = tf::fit_similarity_alignment(source.points(), sphere.points());
+
+    // The recovered matrix is (1/scale) * R^T, so each row has length 1/scale.
+    const real_t expected = real_t(1) / scale;
+    for (std::size_t r = 0; r < 3; ++r) {
+        real_t row_norm = real_t(0);
+        for (std::size_t c = 0; c < 3; ++c)
+            row_norm += T(r, c) * T(r, c);
+        REQUIRE(std::abs(std::sqrt(row_norm) - expected) < real_t(1e-4));
+    }
+
+    real_t rms = compute_rms_error(source.points(), sphere.points(), T);
+    REQUIRE(rms < real_t(1e-4));
+}
+
 // =============================================================================
 // fit_obb_alignment - Basic alignment
 // =============================================================================
