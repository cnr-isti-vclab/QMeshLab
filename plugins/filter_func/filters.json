{
  "pluginId": "qmeshlab.filter.func",
  "filters": [
    {
      "id": "conditional_vertex_selection",
      "menuPath": "Selection",
      "name": "Conditional Vertex Selection",
      "pythonName": "select_vertices_by_condition",
      "shortDescription": "Selects vertices for which a boolean expression evaluates true.",
      "longDescriptionMarkdown": "Boolean function using muparser lib to perform vertex selection over current mesh.<br>",
      "tags": [
        "selection",
        "muparser",
        "vertex"
      ],
      "inputDomain": "SingleMesh",
      "outputDomain": "ModifyCurrentMesh",
      "incrementalSelection": true,
      "inputRequirements": {
        "requireVertices": true
      },
      "parameters": [
        {
          "id": "condSelect",
          "label": "Boolean Function",
          "help": "Boolean expression evaluated per vertex.",
          "group": "main",
          "type": "string",
          "default": "(q < 0)"
        }
      ],
      "outputModifies": [
        "VS"
      ]
    },
    {
      "id": "conditional_face_selection",
      "menuPath": "Selection",
      "name": "Conditional Face Selection",
      "pythonName": "select_faces_by_condition",
      "shortDescription": "Selects faces for which a boolean expression evaluates true.",
      "longDescriptionMarkdown": "Boolean function using muparser lib to perform faces selection over current mesh.<br>",
      "tags": [
        "selection",
        "muparser",
        "face"
      ],
      "inputDomain": "SingleMesh",
      "outputDomain": "ModifyCurrentMesh",
      "incrementalSelection": true,
      "inputRequirements": {
        "requireFaces": true
      },
      "parameters": [
        {
          "id": "condSelect",
          "label": "Boolean Function",
          "help": "Boolean expression evaluated per face.",
          "group": "main",
          "type": "string",
          "default": "(fi == 0)"
        }
      ],
      "outputModifies": [
        "FS"
      ]
    },
    {
      "id": "per_vertex_geometric_function",
      "menuPath": "Compute/Geometry",
      "name": "Per Vertex Geometric Function",
      "pythonName": "apply_vertex_geometric_function",
      "shortDescription": "Computes new per-vertex coordinates from expressions.",
      "longDescriptionMarkdown": "Geometric function using muparser lib to generate new Coord<br>You can change x,y,z for every vertex according to the function specified.<br>",
      "tags": [
        "geometry",
        "muparser",
        "vertex"
      ],
      "inputDomain": "SingleMesh",
      "outputDomain": "ModifyCurrentMesh",
      "inputRequirements": {
        "requireVertices": true
      },
      "parameters": [
        {
          "id": "x",
          "label": "X Function",
          "help": "Expression for X output.",
          "group": "main",
          "type": "string",
          "default": "x"
        },
        {
          "id": "y",
          "label": "Y Function",
          "help": "Expression for Y output.",
          "group": "main",
          "type": "string",
          "default": "y"
        },
        {
          "id": "z",
          "label": "Z Function",
          "help": "Expression for Z output.",
          "group": "main",
          "type": "string",
          "default": "sin(x+y)"
        },
        {
          "id": "onselected",
          "label": "Only On Selection",
          "help": "If enabled, the filter affects only selected elements.",
          "group": "main",
          "type": "bool",
          "default": false
        }
      ],
      "outputModifies": [
        "VG",
        "VN"
      ]
    },
