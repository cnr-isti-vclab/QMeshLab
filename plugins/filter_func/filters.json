          "min": 2,
          "max": 100000
        },
        {
          "id": "numVertY",
          "label": "Vertices Y",
          "help": "Number of vertices along Y.",
          "group": "main",
          "type": "int",
          "default": 10,
          "min": 2,
          "max": 100000
        },
